{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "supervisor",
  "permissions": [
    { "action": "read", "resource": "*", "effect": "allow" },
    { "action": "read", "resource": "*.env", "effect": "deny" },
    { "action": "read", "resource": "*.env.*", "effect": "deny" },
    { "action": "read", "resource": "*.env.example", "effect": "allow" },
    { "action": "shell", "resource": "*", "effect": "allow" },
    { "action": "shell", "resource": "*Get-Content *.env*", "effect": "deny" },
    { "action": "shell", "resource": "*cat *.env*", "effect": "deny" },
    { "action": "shell", "resource": "*type *.env*", "effect": "deny" },
    { "action": "shell", "resource": "git push *", "effect": "ask" },
    { "action": "shell", "resource": "git reset --hard *", "effect": "deny" },
    { "action": "shell", "resource": "git clean *", "effect": "deny" },
    { "action": "shell", "resource": "git checkout -- *", "effect": "ask" },
    { "action": "shell", "resource": "git restore *", "effect": "ask" },
    { "action": "shell", "resource": "rm -rf *", "effect": "deny" },
    { "action": "shell", "resource": "*Remove-Item * -Recurse *", "effect": "deny" },
    { "action": "shell", "resource": "*del /s *", "effect": "deny" },
    { "action": "shell", "resource": "*rd /s *", "effect": "deny" },
    { "action": "shell", "resource": "format *", "effect": "deny" },
    { "action": "shell", "resource": "docker compose down -v *", "effect": "deny" },
    { "action": "shell", "resource": "docker volume rm *", "effect": "deny" },
    { "action": "shell", "resource": "docker system prune *", "effect": "deny" }
  ]
}
